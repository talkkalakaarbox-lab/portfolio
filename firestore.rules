rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'ttPLIKzrWvUCayL3RpGWGBwU6P53';
    }
    match /{document=**} { allow read, write: if false; }
  }
}
